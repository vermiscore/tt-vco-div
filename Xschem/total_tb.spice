.param mc_mm_switch=0
.lib '/home/user/.volare/volare/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.tech/ngspice/sky130.lib.spice' tt

* ---- layout parasitic caps (put * at line start to disable) ----
.include /home/user/Desktop/myfolder/project/rf/rf_transmitter/layout/align_work/5ghz/tt_top/tb_sch/parasitic_caps.spice

* Supply source (pin side)
VDD vsup gpin 1.8
* TT PDN drop (~0.1 V @ 20 mA per TT spec)
RPDN vsup vdd 5
* on-chip GND route (from IR-drop extraction, conservative)
RGND gpin GND 2

*Vvcont vctl GND 0.4
Vvcont vctl GND SIN(0.4 0.01 200e6)
Rvc    vctl vcont 500
*Cvc    vcont GND 4p

* ---- TT analog pad path + SDR (ua[0] = buff_out3) ----
Rpad3  buff_out3 pad3 500
Cpad3  pad3 GND 5p
Cpcb3  pad3 GND 2p
Cdc3   pad3 sdr 100p
Rsdr   sdr  GND 50

* ---- ua[1] = buff_out4: same path, terminated with 50 ohm ----
Rpad4  buff_out4 pad4 500
Cpad4  pad4 GND 5p
Cpcb4  pad4 GND 2p
Cdc4   pad4 term4 100p
Rterm4 term4 GND 50

.nodeset v(q)=1.5 v(q_bar)=1.9 v(net2)=1.9 v(net3)=1.5

.control
tran 10p 300n

* ---- numbers to compare ----


meas tran pp_vco  PP  v(out1)      from=200n to=300n
meas tran pp_buf  PP  v(buff_out1) from=200n to=300n
meas tran pp_out3 PP  v(buff_out3) from=200n to=300n



meas tran idd_avg AVG i(vdd)       from=200n to=300n
meas tran vmid AVG v(buff_out3) from=200n to=300n
meas tran tper TRIG v(buff_out3) VAL=$&vmid RISE=150 TARG v(buff_out3) VAL=$&vmid RISE=170
let f_vco = 8 * 20 / tper
print f_vco

* ---- output pin / SDR ----
meas tran pp_pad PP v(pad3) from=200n to=300n
meas tran pp_sdr PP v(sdr)  from=200n to=300n
let p_sdr_dbm = 10*log10((pp_sdr/2)^2/(2*50)/1e-3)
print pp_pad pp_sdr p_sdr_dbm

* ---- waveforms ----
plot v(out1) v(out2) xlimit 250n 250.5n
plot v(buff_out1) v(buff_out2) xlimit 250n 250.5n
plot v(buff_out3) v(buff_out4) xlimit 250n 260n
plot v(buff_out3) v(pad3) v(sdr) xlimit 250n 260n

* ---- FFT (DC removed) ----
linearize out1 buff_out1 buff_out3
let s_vco  = out1      - mean(out1)
let s_buf  = buff_out1 - mean(buff_out1)
let s_out3 = buff_out3 - mean(buff_out3)
set specwindow=hanning
fft s_vco s_buf s_out3
plot db(mag(s_vco)) db(mag(s_buf)) xlimit 3e9 8e9
plot db(mag(s_out3)) xlimit 0 2e9
setplot tran1

linearize  q q2 q3 buff_out3  out1 buff_out1
fft  q q2 q3 buff_out3 out1 buff_out1
wrdata fft_result.txt mag(q)
*plot mag(clk) xlimit 1e9 8e9
plot mag(q) xlimit 1e9 8e9
plot mag(q2) xlimit 1e9 8e9
plot mag(q3) xlimit 0.3e9 5e9
plot mag(q3) xlimit 0.6e9 1e9
plot mag(buff_out3) xlimit 0e9 8e9
plot mag(buff_out3) xlimit 0.6e9 1e9
plot mag(out1) xlimit 4e9 7e9
plot mag(buff_out1) xlimit 4e9 7e9


* ---- FFT (DC removed) ----
linearize out1 buff_out1 buff_out3
let s_vco  = out1      - mean(out1)
let s_buf  = buff_out1 - mean(buff_out1)
let s_out3 = buff_out3 - mean(buff_out3)
set specwindow=hanning
fft s_vco s_buf s_out3
let sv = db(mag(s_vco))
meas sp carrier MAX sv from=5.10e9 to=5.28e9
meas sp spur_lo MAX sv from=4.93e9 to=5.05e9
meas sp spur_hi MAX sv from=5.33e9 to=5.45e9

plot sv xlimit 4.9e9 5.5e9


.endc


